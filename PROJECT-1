from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC


class BasePage:

    def __init__(self, driver):
        self.driver = driver
        self.wait = WebDriverWait(driver, 10)

    def click(self, locator):
        element = self.wait.until(
            EC.element_to_be_clickable(locator)
        )
        element.click()

    def get_text(self, locator):
        element = self.wait.until(
            EC.visibility_of_element_located(locator)
        )
        return element.text

    def is_visible(self, locator):
        try:
            self.wait.until(
                EC.visibility_of_element_located(locator)
            )
            return True

        except Exception:
            return False

    def enter_text(self, locator, text):

        element = self.wait.until(
            EC.visibility_of_element_located(locator)
        )

        element.clear()

        element.send_keys(text)


from selenium.webdriver.common.by import By
from pages.base_page import BasePage

class HomePage(BasePage):

    LOGIN_BUTTON = (
        By.XPATH,
        "//a[contains(text(),'Login') or contains(@href,'login')]"
    )

    SIGNUP_BUTTON = (
        By.XPATH,
        "//a[contains(text(),'Sign Up') or contains(text(),'SignUp')]"
    )

    COURSES_MENU = (
        By.XPATH,
        "//*[contains(text(),'Courses')]"
    )

    LIVE_CLASSES_MENU = (
        By.XPATH,
        "//*[contains(text(),'LIVE Classes')]"
    )

    PRACTICE_MENU = (
        By.XPATH,
        "//*[contains(text(),'Practice')]"
    )

    DOBBY_ASSISTANT = (
        By.XPATH,
        "//*[contains(@class,'dobby') or contains(text(),'Dobby')]"
    )

    def open(self, url):
        self.driver.get(url)

    def click_login(self):
        self.click(self.LOGIN_BUTTON)

    def click_signup(self):
        self.click(self.SIGNUP_BUTTON)

    def is_login_visible(self):
        return self.is_visible(self.LOGIN_BUTTON)

    def is_signup_visible(self):
        return self.is_visible(self.SIGNUP_BUTTON)

    def is_courses_visible(self):
        return self.is_visible(self.COURSES_MENU)

    def is_live_classes_visible(self):
        return self.is_visible(self.LIVE_CLASSES_MENU)

    def is_practice_visible(self):
        return self.is_visible(self.PRACTICE_MENU)

    def is_dobby_visible(self):
        return self.is_visible(self.DOBBY_ASSISTANT)



from selenium.webdriver.common.by import By
from pages.base_page import BasePage

class LoginPage(BasePage):

    EMAIL_INPUT = (
        By.XPATH,
        "//input[@type='email']"
    )

    PASSWORD_INPUT = (
        By.XPATH,
        "//input[@type='password']"
    )

    LOGIN_BUTTON = (
        By.XPATH,
        "//button[contains(text(),'Login') or contains(text(),'Sign In')]"
    )

    ERROR_MESSAGE = (
        By.XPATH,
        "//*[contains(@class,'error') or contains(text(),'Invalid')]"
    )

    PROFILE_ICON = (
        By.XPATH,
        "//*[contains(@class,'profile')]"
    )

    LOGOUT_BUTTON = (
        By.XPATH,
        "//*[contains(text(),'Logout') or contains(text(),'Sign Out')]"
    )

    def login(self, email, password):

        self.enter_text(
            self.EMAIL_INPUT,
            email
        )

        self.enter_text(
            self.PASSWORD_INPUT,
            password
        )

        self.click(self.LOGIN_BUTTON)

    def get_error_message(self):
        return self.get_text(self.ERROR_MESSAGE)

    def logout(self):
        self.click(self.PROFILE_ICON)
        self.click(self.LOGOUT_BUTTON)


import pytest
from pages.home_page import HomePage
from utilities.config import BASE_URL


class TestGuviHomePage:

    def test_verify_url(self, driver):

        home_page = HomePage(driver)

        home_page.open(BASE_URL)

        assert "guvi.in" in driver.current_url


    def test_verify_title(self, driver):

        home_page = HomePage(driver)

        home_page.open(BASE_URL)

        expected_title = (
            "GUVI | Learn to code in your native language"
        )

        assert driver.title == expected_title


    def test_login_button_visibility_and_clickability(self, driver):

        home_page = HomePage(driver)

        home_page.open(BASE_URL)

        assert home_page.is_login_visible()

        home_page.click_login()

        assert "login" in driver.current_url.lower()


    def test_signup_button_visibility_and_clickability(self, driver):

        home_page = HomePage(driver)

        home_page.open(BASE_URL)

        assert home_page.is_signup_visible()

        home_page.click_signup()

        assert "register" in driver.current_url.lower()


    def test_signup_redirect_url(self, driver):

        home_page = HomePage(driver)

        home_page.open(BASE_URL)

        home_page.click_signup()

        expected_url = "https://www.guvi.in/register/"

        assert driver.current_url == expected_url


    def test_menu_items_visibility(self, driver):

        home_page = HomePage(driver)

        home_page.open(BASE_URL)

        assert home_page.is_courses_visible()

        assert home_page.is_live_classes_visible()

        assert home_page.is_practice_visible()


    def test_dobby_assistant_visibility(self, driver):

        home_page = HomePage(driver)

        home_page.open(BASE_URL)

        assert home_page.is_dobby_visible()


from pages.home_page import HomePage
from pages.login_page import LoginPage
from utilities.config import (
    BASE_URL,
    VALID_EMAIL,
    VALID_PASSWORD,
    INVALID_EMAIL,
    INVALID_PASSWORD
)


class TestGuviLogin:

    def test_valid_login(self, driver):

        home_page = HomePage(driver)

        home_page.open(BASE_URL)

        home_page.click_login()

        login_page = LoginPage(driver)

        login_page.login(
            VALID_EMAIL,
            VALID_PASSWORD
        )

        assert "dashboard" in driver.current_url.lower() \
            or "profile" in driver.current_url.lower()


    def test_invalid_login(self, driver):

        home_page = HomePage(driver)

        home_page.open(BASE_URL)

        home_page.click_login()

        login_page = LoginPage(driver)

        login_page.login(
            INVALID_EMAIL,
            INVALID_PASSWORD
        )

        error_message = (
            login_page.get_error_message()
        )

        assert error_message != ""


    def test_logout(self, driver):

        home_page = HomePage(driver)

        home_page.open(BASE_URL)

        home_page.click_login()

        login_page = LoginPage(driver)

        login_page.login(
            VALID_EMAIL,
            VALID_PASSWORD
        )

        login_page.logout()

        assert (
            "login" in driver.current_url.lower()
            or driver.current_url == BASE_URL
        )
