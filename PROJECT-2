def get_csv_login_data():
    """Helper method executing programmatic context reading operations over CSV payloads."""
    path = os.path.join(os.path.dirname(__file__), "../data/login_data.csv")
    dataset = []
    with open(path, str('r')) as f:
        reader = csv.DictReader(f)
        for row in reader:
            dataset.append((row['username'], row['password'], row['status']))
    return dataset


@pytest.mark.usefixtures("setup")
class TestOrangeHRMSuite:

    @pytest.fixture(autouse=True)
    def initialize_page_objects(self):
        self.login_page = LoginPage(self.driver)
        self.dashboard_page = DashboardPage(self.driver)
        self.admin_page = AdminPage(self.driver)
        self.my_info_page = MyInfoPage(self.driver)
        self.leave_page = LeavePage(self.driver)
        self.claim_page = ClaimPage(self.driver)
        self.base_url = "https://opensource-demo.orangehrmlive.com"

    @pytest.mark.parametrize("user, pwd, expectation", get_csv_login_data())
    def test_case_01_data_driven_login(self, user, pwd, expectation):
        self.logger.info(f"Test Case 1: Running Login iteration profiles -> User: {user}, Context: {expectation}")
        self.login_page.open_url(self.base_url)
        self.login_page.login(user, pwd)

        if expectation == "valid":
            assert "dashboard" in self.driver.current_url.lower(), "Expected validation routing targets missed."
            self.dashboard_page.logout()
        else:
            assert self.login_page.is_element_displayed(
                LoginPage.ERROR_MESSAGE), "Expected authentication failure banner text omitted."

    def test_case_02_url_accessibility(self):
        self.logger.info("Test Case 2: Checking accessibility routes.")
        self.login_page.open_url(self.base_url)
        assert "orangehrmlive" in self.login_page.get_current_url(), "Core endpoint navigation route broke synchronization down."

    def test_case_03_fields_visibility(self):
        self.logger.info("Test Case 3: Validating active input states on landing interface.")
        self.login_page.open_url(self.base_url)
        assert self.login_page.verify_fields_visible(), "Core authentication input hooks are missing from DOM layout structure."

    def test_case_04_menu_items_functional_check(self):
        self.logger.info("Test Case 4: Verifying cross-functional capabilities inside system navigation bar headers.")
        self.login_page.open_url(self.base_url)
        self.login_page.login("Admin", "admin123")

        menus = ["Admin", "PIM", "Leave", "Time", "Recruitment", "My Info", "Performance", "Dashboard"]
        for target in menus:
            assert self.dashboard_page.verify_menu_item(
                target), f"Essential header components target reference missing: {target}"
        self.dashboard_page.logout()

    def test_case_05_create_and_validate_new_user(self):
        self.logger.info("Test Case 5: Orchestrating profile records instantiation routines.")
        self.login_page.open_url(self.base_url)
        self.login_page.login("Admin", "admin123")
        self.dashboard_page.click_menu_item("Admin")

        # Deploy context configurations mapping standard test user criteria
        self.admin_page.add_user("m", "AutomatedTesterSuiteX1", "SecureAccessPass123!")
        self.dashboard_page.logout()

        # Validate authentication performance targeting newly configured profiles
        self.login_page.login("AutomatedTesterSuiteX1", "SecureAccessPass123!")
        assert "dashboard" in self.driver.current_url.lower(), "Newly provisioned test profile failed to pass authorization layers."
        self.dashboard_page.logout()

    def test_case_06_admin_search_verification(self):
        self.logger.info("Test Case 6: Searching generated context models inside structural tracking directories.")
        self.login_page.open_url(self.base_url)
        self.login_page.login("Admin", "admin123")
        self.dashboard_page.click_menu_item("Admin")

        is_found = self.admin_page.search_for_user("AutomatedTesterSuiteX1")
        assert is_found, "The test profile configuration records could not be recovered from the active dataset views layer."
        self.dashboard_page.logout()

    def test_case_07_forgot_password_verification(self):
        self.logger.info(
            "Test Case 7: Validating programmatic logic path patterns inside Forgot Password recovery maps.")
        self.login_page.open_url(self.base_url)
        self.login_page.click_forgot_password()
        self.login_page.submit_password_reset("Admin")
        assert self.login_page.is_reset_confirmation_displayed(), "Password reset verification tracking indicators missing."

    def test_case_08_my_info_sections_check(self):
        self.logger.info("Test Case 8: Tracking access routes across core personal profile layouts.")
        self.login_page.open_url(self.base_url)
        self.login_page.login("Admin", "admin123")
        self.dashboard_page.click_menu_item("My Info")

        submenus = ["Personal Details", "Contact Details", "Emergency Contacts"]
        for section in submenus:
            assert self.my_info_page.verify_submenu_clickable(
                section), f"Sub-menu target section error indicator: {section}"
        self.dashboard_page.logout()

    def test_case_09_assign_leave_transaction(self):
        self.logger.info("Test Case 9: Confirming system action capabilities for employee time-off allocations.")
        self.login_page.open_url(self.base_url)
        self.login_page.login("Admin", "admin123")
        self.dashboard_page.click_menu_item("Leave")

        success = self.leave_page.assign_employee_leave("m")
        assert success, "Execution failed to create transaction records matching target operations."
        self.dashboard_page.logout()

    def test_case_10_initiate_claim_request(self):
        self.logger.info(
            "Test Case 10: Launching programmatic asset verification routines targeting corporate expense reports.")
        self.login_page.open_url(self.base_url)
        self.login_page.login("Admin", "admin123")
        self.dashboard_page.click_menu_item("Claim")

        self.claim_page.initiate_expense_claim("Automation Testing Execution Reimbursement Framework Payload")
        assert self.claim_page.is_claim_submitted_in_history(), "The generated claim validation asset was omitted from database logging files tracking lists."
