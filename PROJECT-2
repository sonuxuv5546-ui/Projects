    USER_ROLE_DROPDOWN = (By.XPATH, "(//div[@class='oxd-select-text oxd-select-text--active'])[1]")
    USER_ROLE_OPTION = (By.XPATH, "//div[@role='option']/span[text()='ESS']")
    STATUS_DROPDOWN = (By.XPATH, "(//div[@class='oxd-select-text oxd-select-text--active'])[2]")
    STATUS_OPTION = (By.XPATH, "//div[@role='option']/span[text()='Enabled']")

    EMPLOYEE_NAME_INPUT = (By.XPATH, "//input[@placeholder='Type for hints...']")
    EMPLOYEE_SUGGESTION = (By.XPATH, "//div[@role='option']/span")
    USERNAME_INPUT = (By.XPATH, "(//input[@class='oxd-input oxd-input--active'])[2]")
    PASSWORD_INPUT = (By.XPATH, "(//input[@type='password'])[1]")
    CONFIRM_PASSWORD_INPUT = (By.XPATH, "(//input[@type='password'])[2]")
    SAVE_BUTTON = (By.XPATH, "//button[@type='submit']")

    SEARCH_USERNAME_FIELD = (By.XPATH, "(//input[@class='oxd-input oxd-input--active'])[2]")
    SEARCH_SUBMIT_BUTTON = (By.XPATH, "//button[@type='submit']")
    RECORD_FOUND_CELL = (By.XPATH, "//div[@class='oxd-table-card']/div[@role='row']")

    def add_user(self, emp_hint, username, password):
        self.click_element(self.ADD_BUTTON)
        self.click_element(self.USER_ROLE_DROPDOWN)
        self.click_element(self.USER_ROLE_OPTION)
        self.click_element(self.STATUS_DROPDOWN)
        self.click_element(self.STATUS_OPTION)

        self.enter_text(self.EMPLOYEE_NAME_INPUT, emp_hint)
        # Allow input to populate options via application background framework routines safely
        time.sleep(2.5)
        self.click_element(self.EMPLOYEE_SUGGESTION)

        self.enter_text(self.USERNAME_INPUT, username)
        self.enter_text(self.PASSWORD_INPUT, password)
        self.enter_text(self.CONFIRM_PASSWORD_INPUT, password)
        time.sleep(1.0)
