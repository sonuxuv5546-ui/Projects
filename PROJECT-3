from selenium.webdriver.common.by import By
from pages.base_page import BasePage


class LoginPage(BasePage):
    """Page object encapsulating SauceDemo login page behavior."""

    USERNAME = (By.ID, "user-name")
    PASSWORD = (By.ID, "password")
    LOGIN_BUTTON = (By.ID, "login-button")
    ERROR_MESSAGE = (By.CSS_SELECTOR, "[data-test='error']")

    def login(self, username, password):
        self.enter_text(self.USERNAME, username)
        self.enter_text(self.PASSWORD, password)
        self.click_element(self.LOGIN_BUTTON)

    def get_error_message(self):
        return self.get_text_safe(self.ERROR_MESSAGE)

    def get_text_safe(self, locator):
        if self.is_element_displayed(locator):
            return self.find_element(locator).text
        return ""



import random

from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import Select
from pages.base_page import BasePage


class InventoryPage(BasePage):
    """Page object for the product inventory/catalog."""

    PAGE_TITLE = (By.CLASS_NAME, "title")
    CART_ICON = (By.CLASS_NAME, "shopping_cart_link")
    CART_BADGE = (By.CLASS_NAME, "shopping_cart_badge")
    INVENTORY_ITEMS = (By.CLASS_NAME, "inventory_item")
    ITEM_NAME = (By.CLASS_NAME, "inventory_item_name")
    ITEM_PRICE = (By.CLASS_NAME, "inventory_item_price")
    ADD_BUTTON = (By.XPATH, ".//button[contains(@class, 'btn_inventory')]")
    SORT_DROPDOWN = (By.CLASS_NAME, "product_sort_container")
    MENU_BUTTON = (By.ID, "react-burger-menu-btn")
    LOGOUT_LINK = (By.ID, "logout_sidebar_link")
    RESET_LINK = (By.ID, "reset_sidebar_link")
    MENU_CLOSE = (By.ID, "react-burger-cross-btn")

    def is_inventory_page(self):
        return self.is_element_displayed(self.PAGE_TITLE) and \
            self.find_element(self.PAGE_TITLE).text == "Products"

    def is_cart_icon_visible(self):
        return self.is_element_displayed(self.CART_ICON)

    def get_cart_badge_count(self):
        if self.is_element_displayed(self.CART_BADGE):
            return int(self.find_element(self.CART_BADGE).text)
        return 0

    def get_all_products(self):
        """Return product records with names and numeric prices."""
        records = []
        for item in self.find_elements(self.INVENTORY_ITEMS):
            name = item.find_element(*self.ITEM_NAME).text
            price_text = item.find_element(*self.ITEM_PRICE).text
            records.append({
                "name": name,
                "price": float(price_text.replace("$", "")),
                "element": item,
            })
        return records

    def select_random_products(self, quantity=4):
        products = self.get_all_products()
        if quantity > len(products):
            raise ValueError(
                f"Cannot select {quantity} products from {len(products)} available"
            )
        selected = random.sample(products, quantity)
        self.logger.info(
            "Randomly selected products: %s",
            [(item["name"], item["price"]) for item in selected],
        )
        return selected

    def add_products_to_cart(self, selected_products):
        """Add selected product cards using their scoped Add to cart button."""
        for product in selected_products:
            product["element"].find_element(*self.ADD_BUTTON).click()

    def go_to_cart(self):
        self.click_element(self.CART_ICON)

    def sort_products_by(self, visible_text):
        Select(self.find_element(self.SORT_DROPDOWN)).select_by_visible_text(
            visible_text
        )

    def get_all_product_names(self):
        return [item.text for item in self.find_elements(self.ITEM_NAME)]

    def get_all_product_prices(self):
        return [
            float(item.text.replace("$", ""))
            for item in self.find_elements(self.ITEM_PRICE)
        ]

    def open_sidebar_menu(self):
        self.click_element(self.MENU_BUTTON)

    def logout(self):
        self.open_sidebar_menu()
        self.click_element(self.LOGOUT_LINK)

    def reset_app_state(self):
        self.open_sidebar_menu()
        self.click_element(self.RESET_LINK)
        self.click_element(self.MENU_CLOSE)


import os
from datetime import datetime

from selenium.webdriver.common.by import By
from pages.base_page import BasePage


class CheckoutPage(BasePage):
    """Page object for checkout information, summary, and confirmation."""

    FIRST_NAME = (By.ID, "first-name")
    LAST_NAME = (By.ID, "last-name")
    POSTAL_CODE = (By.ID, "postal-code")
    CONTINUE_BUTTON = (By.ID, "continue")
    SUMMARY_ITEMS = (By.CLASS_NAME, "cart_item")
    SUMMARY_TOTAL = (By.CLASS_NAME, "summary_total_label")
    FINISH_BUTTON = (By.ID, "finish")
    COMPLETE_HEADER = (By.CLASS_NAME, "complete-header")

    def fill_shipping_details(self, first_name, last_name, postal_code):
        self.enter_text(self.FIRST_NAME, first_name)
        self.enter_text(self.LAST_NAME, last_name)
        self.enter_text(self.POSTAL_CODE, postal_code)
        self.click_element(self.CONTINUE_BUTTON)

    def get_summary_items(self):
        details = []
        for item in self.find_elements(self.SUMMARY_ITEMS):
            name = item.find_element(
                By.CLASS_NAME, "inventory_item_name"
            ).text
            price = float(
                item.find_element(
                    By.CLASS_NAME, "inventory_item_price"
                ).text.replace("$", "")
            )
            details.append({"name": name, "price": price})
        return details

    def capture_order_summary_screenshot(self, test_name):
        os.makedirs("screenshots", exist_ok=True)
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        filepath = os.path.join(
            "screenshots", f"{test_name}_{timestamp}.png"
        )
        self.driver.save_screenshot(filepath)
        self.logger.info("Order summary screenshot saved: %s", filepath)
        return filepath

    def finalize_order(self):
        self.click_element(self.FINISH_BUTTON)

    def get_confirmation_message(self):
        return self.find_element(self.COMPLETE_HEADER).text



import logging

from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from selenium.common.exceptions import TimeoutException


class BasePage:
    """Common Selenium interactions inherited by all page objects."""

    def __init__(self, driver, timeout=15):
        self.driver = driver
        self.wait = WebDriverWait(driver, timeout)
        self.logger = logging.getLogger(self.__class__.__name__)

    def open_url(self, url):
        self.logger.info("Navigating to %s", url)
        self.driver.get(url)

    def find_element(self, locator):
        try:
            return self.wait.until(EC.visibility_of_element_located(locator))
        except TimeoutException as exc:
            raise AssertionError(f"Element not visible: {locator}") from exc

    def find_elements(self, locator):
        try:
            return self.wait.until(EC.visibility_of_all_elements_located(locator))
        except TimeoutException:
            return []

    def click_element(self, locator):
        try:
            self.wait.until(EC.element_to_be_clickable(locator)).click()
        except TimeoutException as exc:
            raise AssertionError(f"Element not clickable: {locator}") from exc

    def enter_text(self, locator, text):
        element = self.find_element(locator)
        element.clear()
        element.send_keys(text)

    def is_element_displayed(self, locator):
        try:
            return self.wait.until(EC.visibility_of_element_located(locator)).is_displayed()
        except TimeoutException:
            return False




