from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

from selenium.common.exceptions import (
    TimeoutException,
    WebDriverException
)


class BasePage:
    """
    Parent page class.

    Provides reusable Selenium operations.
    Implements inheritance and encapsulation.
    """

    def __init__(self, driver):
        self.driver = driver
        self.wait = WebDriverWait(driver, 20)

    def click(self, locator):
        """Wait for an element and click it."""
        try:
            element = self.wait.until(
                EC.element_to_be_clickable(locator)
            )
            element.click()

        except TimeoutException as error:
            raise AssertionError(
                f"Element not clickable: {locator}"
            ) from error

        except WebDriverException as error:
            raise AssertionError(
                f"Click operation failed: {locator}"
            ) from error

    def enter_text(self, locator, text):
        """Clear the field and enter the supplied text."""
        try:
            element = self.wait.until(
                EC.visibility_of_element_located(locator)
            )
            element.clear()
            element.send_keys(text)

        except TimeoutException as error:
            raise AssertionError(
                f"Input field not visible: {locator}"
            ) from error

        except WebDriverException as error:
            raise AssertionError(
                f"Unable to enter text: {locator}"
            ) from error

    def is_visible(self, locator):
        """Return True if the element is visible."""
        try:
            self.wait.until(
                EC.visibility_of_element_located(locator)
            )
            return True

        except TimeoutException:
            return False

    def get_text(self, locator):
        """Get text from a visible element."""
        try:
            element = self.wait.until(
                EC.visibility_of_element_located(locator)
            )
            return element.text

        except TimeoutException as error:
            raise AssertionError(
                f"Element text not found: {locator}"
            ) from error




from selenium.webdriver.common.by import By

from pages.base_page import BasePage


class HomePage(BasePage):
    """
    Page Object for the GUVI home page.
    """

    URL = "https://www.guvi.in/"

    # Update locators if the current website DOM differs.
    LOGIN_BUTTON = (
        By.XPATH,
        "//a[contains(@href,'login') or contains(text(),'Login')]"
    )

    SIGNUP_BUTTON = (
        By.XPATH,
        "//a[contains(@href,'register') or contains(text(),'Sign Up')]"
    )

    HOME_CONTENT = (
        By.TAG_NAME,
        "body"
    )

    def open_home_page(self):
        """Navigate to GUVI home page."""
        self.driver.get(self.URL)

    def is_home_page_displayed(self):
        """Verify home page body is visible."""
        return self.is_visible(self.HOME_CONTENT)

    def click_login(self):
        """Click Login button."""
        self.click(self.LOGIN_BUTTON)

    def is_login_button_displayed(self):
        """Check Login button visibility."""
        return self.is_visible(self.LOGIN_BUTTON)

    def is_signup_button_displayed(self):
        """Check Sign-Up button visibility."""
        return self.is_visible(self.SIGNUP_BUTTON)




from selenium.webdriver.common.by import By

from pages.base_page import BasePage


class LoginPage(BasePage):
    """
    Page Object for GUVI login page.
    """

    # IMPORTANT:
    # Inspect the actual GUVI login page and update locators.
    USERNAME_FIELD = (
        By.ID,
        "email"
    )

    PASSWORD_FIELD = (
        By.ID,
        "password"
    )

    LOGIN_SUBMIT_BUTTON = (
        By.XPATH,
        "//button[@type='submit']"
    )

    ERROR_MESSAGE = (
        By.CSS_SELECTOR,
        ".error-message"
    )

    LOGOUT_BUTTON = (
        By.XPATH,
        "//button[contains(text(),'Logout')]"
    )

    HOME_ELEMENT = (
        By.TAG_NAME,
        "body"
    )

    def enter_username(self, username):
        """Enter username/email."""
        self.enter_text(
            self.USERNAME_FIELD,
            username
        )

    def enter_password(self, password):
        """Enter password."""
        self.enter_text(
            self.PASSWORD_FIELD,
            password
        )

    def click_submit(self):
        """Submit login form."""
        self.click(
            self.LOGIN_SUBMIT_BUTTON
        )

    def login(self, username, password):
        """Perform login."""
        self.enter_username(username)
        self.enter_password(password)
        self.click_submit()

    def is_login_error_displayed(self):
        """Check error message visibility."""
        return self.is_visible(
            self.ERROR_MESSAGE
        )

    def is_username_field_displayed(self):
        """Check username field visibility."""
        return self.is_visible(
            self.USERNAME_FIELD
        )

    def is_password_field_displayed(self):
        """Check password field visibility."""
        return self.is_visible(
            self.PASSWORD_FIELD
        )

    def is_submit_button_displayed(self):
        """Check submit button visibility."""
        return self.is_visible(
            self.LOGIN_SUBMIT_BUTTON
        )

    def is_submit_button_enabled(self):
        """Check submit button enabled state."""
        element = self.driver.find_element(
            *self.LOGIN_SUBMIT_BUTTON
        )
        return element.is_enabled()

    def is_logged_in(self):
        """Check authenticated page is visible."""
        return self.is_visible(
            self.HOME_ELEMENT
        )

    def logout(self):
        """Click logout button."""
        self.click(
            self.LOGOUT_BUTTON
        )


import os

from selenium import webdriver
from selenium.webdriver.chrome.options import Options

from pages.home_page import HomePage
from pages.login_page import LoginPage


def before_scenario(context, scenario):
    """
    Launch browser before every scenario.
    Initialize page objects and credentials.
    """

    options = Options()
    options.add_argument("--start-maximized")

    # Start Chrome browser.
    context.driver = webdriver.Chrome(
        options=options
    )

    # URL.
    context.base_url = "https://www.guvi.in/"

    # Credentials must be configured locally.
    context.username = os.getenv(
        "GUVI_USERNAME",
        "YOUR_VALID_EMAIL"
    )

    context.password = os.getenv(
        "GUVI_PASSWORD",
        "YOUR_VALID_PASSWORD"
    )

    # Initialize page objects.
    context.home_page = HomePage(
        context.driver
    )

    context.login_page = LoginPage(
        context.driver
    )


def after_scenario(context, scenario):
    """
    Close browser after scenario execution.
    """

    if hasattr(context, "driver"):
        try:
            context.driver.quit()

        except Exception as error:
            print(
                f"Browser cleanup error: {error}"
            )



from behave import given, when, then


@given("I navigate to the GUVI home page")
def navigate_to_home(context):
    """Navigate to GUVI home page."""
    context.home_page.open_home_page()


@then("the GUVI home page should be displayed")
def verify_home_page(context):
    """Verify GUVI home page."""
    assert context.home_page.is_home_page_displayed(), (
        "GUVI home page is not displayed"
    )


@then("the page title should contain GUVI")
def verify_page_title(context):
    """Verify browser title."""
    title = context.driver.title

    assert "GUVI" in title.upper(), (
        f"Unexpected page title: {title}"
    )


@then("the Login button should be displayed")
def verify_login_button(context):
    """Verify Login button visibility."""
    assert context.home_page.is_login_button_displayed(), (
        "Login button was not displayed"
    )


@then("the Sign-Up button should be displayed")
def verify_signup_button(context):
    """Verify Sign-Up button visibility."""
    assert context.home_page.is_signup_button_displayed(), (
        "Sign-Up button was not displayed"
    )


@when("I click the Login button")
def click_login(context):
    """Navigate to login page."""
    context.home_page.click_login()


@when("I enter valid username and password")
def enter_valid_credentials(context):
    """Enter valid credentials."""
    context.login_page.enter_username(
        context.username
    )

    context.login_page.enter_password(
        context.password
    )


@when("I enter invalid username and password")
def enter_invalid_credentials(context):
    """Enter invalid credentials."""
    context.login_page.enter_username(
        "invalid_user@example.com"
    )

    context.login_page.enter_password(
        "invalid_password"
    )


@when("I submit the login form")
def submit_login(context):
    """Submit login form."""
    context.login_page.click_submit()


@then("I should be logged in successfully")
def verify_login_success(context):
    """Verify successful login."""
    assert context.login_page.is_logged_in(), (
        "Login was unsuccessful"
    )


@then("I should see the authenticated page")
def verify_authenticated_page(context):
    """Verify authenticated page."""
    assert context.login_page.is_logged_in()


@then("I should see a login error message")
def verify_login_error(context):
    """Verify login error message."""
    assert context.login_page.is_login_error_displayed(), (
        "Expected login error message was not displayed"
    )


@then("the username field should be displayed")
def verify_username_field(context):
    """Verify username input field."""
    assert context.login_page.is_username_field_displayed()


@then("the password field should be displayed")
def verify_password_field(context):
    """Verify password input field."""
    assert context.login_page.is_password_field_displayed()


@then("the submit button should be displayed")
def verify_submit_button(context):
    """Verify submit button visibility."""
    assert context.login_page.is_submit_button_displayed()


@then("the submit button should be enabled")
def verify_submit_enabled(context):
    """Verify submit button enabled state."""
    assert context.login_page.is_submit_button_enabled()


@when("I logout from GUVI")
def logout(context):
    """Logout from authenticated page."""
    context.login_page.logout()


@then("I should return to the login page")
def verify_logout(context):
    """Verify return to login page."""
    assert context.login_page.is_username_field_displayed(), (
        "Login page was not displayed after logout"
    )

