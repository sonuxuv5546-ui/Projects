coins = [1, 2, 5, 10]
target = 10

ways = []

for c10 in range(target // 10 + 1):
    for c5 in range(target // 5 + 1):
        for c2 in range(target // 2 + 1):
            for c1 in range(target + 1):
                total = (c10 * 10) + (c5 * 5) + (c2 * 2) + c1

                if total == target:
                    ways.append((c1, c2, c5, c10))

print("Number of ways:", len(ways))

for way in ways:
    c1, c2, c5, c10 = way
    print(f"Rs.1: {c1}, Rs.2: {c2}, Rs.5: {c5}, Rs.10: {c10}")
