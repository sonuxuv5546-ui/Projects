import pytest
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC


HOME_URL = "https://www.guvi.in/"
LOGIN_URL = "https://www.guvi.in/sign-in/"

USERNAME = "sonuxuv5546@gmail.com"
PASSWORD = "Sonu5546@"


@pytest.fixture
def driver():
    options = Options()
    options.add_argument("--start-maximized")
    driver = webdriver.Chrome(options=options)
    driver.implicitly_wait(5)
    yield driver
    driver.quit()


# ---------------------------------------------------
# POSITIVE TEST CASES
# ---------------------------------------------------
def test_login_button_url(driver):
    """
    Validate that clicking Login navigates to the Sign-In URL.
    """
    driver.get(HOME_URL)
    login_button = WebDriverWait(driver, 10).until(
        EC.element_to_be_clickable(
            (By.XPATH, "//a[contains(@href,'sign-in')]")
        )
    )
    login_button.click()
    WebDriverWait(driver, 10).until(
        EC.url_contains("/sign-in/")
    )
    assert driver.current_url.startswith(LOGIN_URL)


def test_username_visible_and_enabled(driver):
    """
    Validate Username field is visible and enabled.
    """
    driver.get(LOGIN_URL)
    username = WebDriverWait(driver, 10).until(
        EC.visibility_of_element_located(
            (By.XPATH, "//input[@placeholder='sonuxuv5546@gmail.com']")
        )
    )
    assert username.is_displayed()
    assert username.is_enabled()


def test_password_visible_and_enabled(driver):
    """
    Validate Password field is visible and enabled.
    """
    driver.get(LOGIN_URL)
    password = WebDriverWait(driver, 10).until(
        EC.visibility_of_element_located(
            (By.XPATH, "//input[@type='Sonu5546@']")
        )
    )
    assert password.is_displayed()
    assert password.is_enabled()
def test_valid_login(driver):

    """
    Login using valid GUVI credentials.
    """

    driver.get(LOGIN_URL)

    username = WebDriverWait(driver, 10).until(
        EC.element_to_be_clickable(
            (By.XPATH, "//input[@placeholder='sonuxuv5546@gmail.com']")
        )
    )

    password = driver.find_element(
        By.XPATH, "//input[@type='Sonu5546@']"
    )
    username.send_keys(USERNAME)
    password.send_keys(PASSWORD)
    login_buttons = driver.find_elements(
        By.XPATH, "//button[contains(.,'Login')] | //input[@value='Login']"
    )
    assert len(login_buttons) > 0
    login_buttons[0].click()
    WebDriverWait(driver, 15).until(
        lambda d: "/sign-in/" not in d.current_url
    )
    assert "/sign-in/" not in driver.current_url


