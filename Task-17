import pytest

from pages.login_page import LoginPage
from pages.dashboard_page import DashboardPage
from utils.config import Config


class TestGUVI:


    #Successful Login
    # Positive Test Case


    def test_successful_login(self, browser_page):

        login_page = LoginPage(browser_page)
        dashboard_page = DashboardPage(browser_page)

        login_page.open()

        login_page.login(
            Config.USERNAME,
            Config.PASSWORD
        )

        assert dashboard_page.is_dashboard_displayed(), \
            "Successful login failed"


    #Unsuccessful Login
    # Negative Test Case


    def test_unsuccessful_login(self, browser_page):

        login_page = LoginPage(browser_page)

        login_page.open()

        login_page.login(
            "invalid_username",
            "invalid_password"
        )

        assert login_page.is_login_page_displayed(), \
            "Invalid credentials should not login"


    # Validate Username


    def test_validate_username_input_box(
        self,
        browser_page
    ):

        login_page = LoginPage(browser_page)

        login_page.open()

        assert login_page.username_displayed(), \
            "Username input box is not displayed"

    # Validate Password


    def test_validate_password_input_box(
        self,
        browser_page
    ):

        login_page = LoginPage(browser_page)

        login_page.open()

        assert login_page.password_displayed(), \
            "Password input box is not displayed"


    # Validate Login Button

    def test_validate_submit_button(
        self,
        browser_page
    ):

        login_page = LoginPage(browser_page)

        login_page.open()

        assert login_page.login_button_displayed(), \
            "Login button is not displayed"

        assert login_page.login_button_enabled(), \
            "Login button is not enabled"

    # Validate Logout


    def test_validate_logout(self, browser_page):

        login_page = LoginPage(browser_page)
        dashboard_page = DashboardPage(browser_page)

        login_page.open()

        login_page.login(
            Config.USERNAME,
            Config.PASSWORD
        )

        assert dashboard_page.is_dashboard_displayed(), \
            "Login failed"

        dashboard_page.logout()

        assert dashboard_page.is_logged_out(), \
            "Logout functionality failed"
