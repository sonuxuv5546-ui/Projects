people = [
    {"name": "Sohan", "age": 25},
    {"name": "Rahul", "age": 16},
    {"name": "Priya", "age": 22},
    {"name": "Amit", "age": 15},
    {"name": "Neha", "age": 30}
]

adults = filter(lambda person: person["age"] >= 18, people)

names = list(map(lambda person: person["name"], adults))

print("People aged 18 or above:", names)
