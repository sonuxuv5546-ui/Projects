class BankAccount:
    def __init__(self, account_number, initial_balance=0.0):
        self.account_number = account_number
        # Private attribute to implement encapsulation
        self.__balance = float(initial_balance)

    # Getter method to access the private balance attribute safely
    def get_balance(self):
        return self.__balance

    def deposit(self, amount):
        if amount > 0:
            self.__balance += amount
            print(f"Deposited ${amount:.2f}. New balance: ${self.__balance:.2f}")
        else:
            print("Deposit amount must be positive.")

    def withdraw(self, amount):
        if amount <= 0:
            print("Withdrawal amount must be positive.")
            return False

        if amount <= self.__balance:
            self.__balance -= amount
            print(f"Withdrew ${amount:.2f}. Remaining balance: ${self.__balance:.2f}")
            return True
        else:
            print("Withdrawal denied: Insufficient funds.")
            return False


class SavingsAccount(BankAccount):
    def __init__(self, account_number, initial_balance=0.0, interest_rate=0.02):
        # Initialize attributes from the parent BankAccount class
        super().__init__(account_number, initial_balance)
        self.interest_rate = float(interest_rate)

    def calculate_interest(self):
        # Calculate interest based on the current balance
        interest = self.get_balance() * self.interest_rate
        print(f"Calculated Interest: ${interest:.2f} (at {self.interest_rate * 100}%)")
        return interest


class CurrentAccount(BankAccount):
    def __init__(self, account_number, initial_balance=0.0, min_balance=500.0):
        super().__init__(account_number, initial_balance)
        self.min_balance = float(min_balance)

    # Override the parent withdraw method to enforce minimum balance rule
    def withdraw(self, amount):
        if amount <= 0:
            print("Withdrawal amount must be positive.")
            return False

        # Ensure that remaining balance won't drop below the minimum required balance
        if self.get_balance() - amount >= self.min_balance:
            # Use parent class method logic to adjust the internal balance state safely
            return super().withdraw(amount)
        else:
            print(f"Withdrawal denied: Must maintain minimum balance of ${self.min_balance:.2f}.")
            return False


print("--- Savings Account Test ---")
savings = SavingsAccount(account_number="SAV123", initial_balance=1000.0, interest_rate=0.05)
savings.deposit(200)
savings.calculate_interest()
savings.withdraw(1500)  # Should fail (insufficient funds)

print("\n--- Current Account Test ---")
current = CurrentAccount(account_number="CUR789", initial_balance=1000.0, min_balance=500.0)
current.withdraw(400)  # Should succeed (remains $600, which is >= $500)
current.withdraw(200)  # Should fail (would leave $400, dropping below $500 min)
