class Employee:
    def __init__(self, name, base_salary):
        self.name = name
        self.base_salary = float(base_salary)

    def calculate_salary(self):
        """Base method to be overridden by subclasses."""
        return self.base_salary


class RegularEmployee(Employee):
    def __init__(self, name, base_salary, bonus):
        super().__init__(name, base_salary)
        self.bonus = float(bonus)

    def calculate_salary(self):
        # Regular employee gets base salary plus a fixed bonus
        return self.base_salary + self.bonus


class ContractEmployee(Employee):
    def __init__(self, name, hourly_rate, hours_worked):
        # Contract employees don't strictly use a base monthly salary, passing 0 to parent
        super().__init__(name, base_salary=0.0)
        self.hourly_rate = float(hourly_rate)
        self.hours_worked = float(hours_worked)

    def calculate_salary(self):
        return self.hourly_rate * self.hours_worked


class Manager(Employee):
    def __init__(self, name, base_salary, team_allowance):
        super().__init__(name, base_salary)
        self.team_allowance = float(team_allowance)

    def calculate_salary(self):
        return self.base_salary + self.team_allowance



employees = [
    RegularEmployee(name="Alice", base_salary=5000, bonus=800),
    ContractEmployee(name="Bob", hourly_rate=45, hours_worked=160),
    Manager(name="Charlie", base_salary=8000, team_allowance=1500)
]

for emp in employees:
    # Python dynamically calls the correct calculate_salary underlying method implementation
    print(f"Employee: {emp.name:8} | Calculated Salary: ${emp.calculate_salary():,.2f}")
