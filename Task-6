class Vehicle:
    def __init__(self, model, rental_rate):
        self.model = model
        self.rental_rate = float(rental_rate)  # Base rate per day

    def calculate_rental(self, days):
        """Base calculation for a standard rental."""
        return self.rental_rate * days


class Car(Vehicle):
    def __init__(self, model, rental_rate, insurance_fee=15.0):
        super().__init__(model, rental_rate)
        self.insurance_fee = float(insurance_fee)

    def calculate_rental(self, days):
        # Cars have an additional flat daily insurance fee
        return (self.rental_rate + self.insurance_fee) * days


class Bike(Vehicle):
    def __init__(self, model, rental_rate, helmet_rent=5.0):
        super().__init__(model, rental_rate)
        self.helmet_rent = float(helmet_rent)

    def calculate_rental(self, days):
        return (self.rental_rate * days) + self.helmet_rent


class Truck(Vehicle):
    def __init__(self, model, rental_rate, weight_capacity_tons):
        super().__init__(model, rental_rate)
        self.weight_capacity_tons = float(weight_capacity_tons)

    def calculate_rental(self, days):
        capacity_surcharge = self.rental_rate * (0.10 * self.weight_capacity_tons)
        return (self.rental_rate + capacity_surcharge) * days



fleet = [
    Car(model="Sedan Core", rental_rate=40.0, insurance_fee=12.0),
    Bike(model="Mountain Tracker", rental_rate=15.0, helmet_rent=5.0),
    Truck(model="Heavy Hauler", rental_rate=100.0, weight_capacity_tons=3.0)
]

rental_days = 5

for vehicle in fleet:
    total_cost = vehicle.calculate_rental(days=rental_days)
    print(f"Vehicle: {vehicle.model:16} | Total Cost for {rental_days} Days: ${total_cost:,.2f}")

